{
  "name": "open-sauce-food",
  "displayName": "Open Sauce Food",
  "description": "Sauce Code highlighting, editing support and Core-backed language-server completion.",
  "version": "0.3.1",
  "publisher": "tebla-local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "contributes": {
    "languages": [
      {
        "id": "opensauce",
        "aliases": [
          "Sauce Code",
          "opensauce"
        ],
        "extensions": [
          ".opensauce"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "opensauce",
        "scopeName": "source.opensauce",
        "path": "./syntaxes/opensauce.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --out ../_work/vscode-extension/open-sauce-food-0.3.1.vsix",
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-languageclient": "9.0.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@types/vscode": "1.90.0",
    "@types/node": "24.10.1"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:opensauce"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
