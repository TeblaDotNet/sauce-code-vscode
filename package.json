{
  "name": "open-sauce-food",
  "displayName": "Open Sauce Food",
  "description": "Optional Sauce Code highlighting and editor support for plain-text .opensauce recipes.",
  "version": "0.1.0",
  "publisher": "tebla-local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "contributes": {
    "languages": [
      {
        "id": "opensauce",
        "aliases": [
          "Sauce Code",
          "opensauce"
        ],
        "extensions": [
          ".opensauce"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "opensauce",
        "scopeName": "source.opensauce",
        "path": "./syntaxes/opensauce.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --out ../_work/vscode-extension/open-sauce-food-0.1.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}